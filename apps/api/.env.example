# Copier ce fichier en .env (jamais commité)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL="file:./dev.db"
# Origine(s) autorisée(s) pour le front (CORS), séparées par des virgules
CORS_ORIGIN=http://localhost:5173
# Mot de passe du compte admin créé par le seed (admin@techshop.local)
SEED_ADMIN_PASSWORD=change-me-admin
# Secret de signature des sessions (32 caractères minimum). Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum
# Tentatives de connexion / inscription autorisées par minute et par IP
AUTH_RATE_LIMIT=10
