# Variables pour docker compose (copier en .env, jamais commité)
SEED_ADMIN_PASSWORD=change-me-admin
# Secret de signature des sessions (32 caractères minimum). Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum
